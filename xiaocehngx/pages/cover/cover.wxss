/* pages/cover/cover.wxss —— 启动封面页样式
   工业简洁风格：深色底（#263238）+ 工业橙（#F57C00）点缀
   与 app.wxss 配色规范保持一致 */

/* ==================== 全屏底色 ==================== */
.page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(ellipse at 50% 35%, #2E3B43 0%, #1B2326 60%, #161B1D 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 140rpx 0 100rpx;
  /* 整体在垂直方向分两块：上面 logo / 标题区，下面加载区 */
}

/* ==================== 顶部品牌区 ==================== */
.brand-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
}

/* ==================== Logo（环形 + 中心图案） ==================== */
.logo {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
}

/* 外环 - 深灰底圈 */
.logo-ring {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border: 4rpx solid #4A5A63;
  border-radius: 50%;
  animation: spin 6s linear infinite;
}

/* 内环 - 工业橙色虚线圈，强调"正在监测"的动感 */
.logo-ring-2 {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #F57C00;
  animation: spin-rev 4s linear infinite;
}

/* 中心图标 */
.logo-core {
  font-size: 100rpx;
  color: #F57C00;
  line-height: 1;
  text-shadow: 0 0 24rpx rgba(245, 124, 0, 0.6);
  animation: pulse 2.4s ease-in-out infinite;
}

/* 旋转动画：外环正向、内环反向（永不停歇的雷达意象） */
@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
@keyframes spin-rev {
  from { transform: rotate(0deg); }
  to   { transform: rotate(-360deg); }
}
/* 中心图标轻微呼吸效果 */
@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.08);
    opacity: 0.85;
  }
}

/* ==================== 主标题 ==================== */
.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 8rpx;
  margin-bottom: 18rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #8A939B;
  letter-spacing: 4rpx;
  font-family: "Courier New", monospace;
  text-transform: uppercase;
  margin-bottom: 36rpx;
}

/* ==================== 标签条（功能关键词） ==================== */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.tag {
  font-size: 22rpx;
  color: #F57C00;
  background-color: rgba(245, 124, 0, 0.10);
  border: 2rpx solid rgba(245, 124, 0, 0.35);
  padding: 8rpx 22rpx;
  border-radius: 30rpx;
}

/* ==================== 底部加载区 ==================== */
.bottom-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

/* 跳动小圆点：3 个，错相位跳动 */
.dot-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  background-color: #F57C00;
  border-radius: 50%;
  margin: 0 10rpx;
  animation: bounce 1.2s ease-in-out infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  40% {
    transform: translateY(-18rpx);
    opacity: 1;
  }
}

.loading-text {
  font-size: 24rpx;
  color: #8A939B;
  letter-spacing: 2rpx;
  margin-bottom: 40rpx;
  font-family: "Courier New", monospace;
}

/* 跳过按钮：透明描边，工业面板风 */
.skip-btn {
  font-size: 26rpx;
  color: #C8E6C9;
  border: 2rpx solid rgba(200, 230, 201, 0.4);
  padding: 14rpx 48rpx;
  border-radius: 40rpx;
  letter-spacing: 4rpx;
}

/* 跳过按钮按压反馈 */
.skip-btn:active {
  background-color: rgba(200, 230, 201, 0.12);
}
